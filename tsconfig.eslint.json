{
    // Type-aware linting needs every file it lints to belong to a program, and
    // the build tsconfig deliberately excludes tests. This one exists only for
    // ESLint: it emits nothing and widens the include to the whole repository.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationDir": null,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": ".",
        // TypeScript 6 no longer pulls in every `@types/*` package on its own,
        // so the test globals have to be named. Without this the tests are a
        // wall of "Cannot find name 'expect'" in any editor.
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "benchmarks/**/*.ts"
    ],
    "exclude": []
}
